<file path="staticfiles/ckeditor/ckeditor/plugins/scayt/dialogs/dialog.css">
div.cke_dialog_ui_scaytItemList {
	border: 1px solid #c9cccf;
}

.cke_scaytItemList-child {
	position: relative;
	padding: 6px 30px 6px 5px;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.cke_scaytItemList-child:hover {
	background: #ebebeb;
}

.cke_scaytItemList-child .cke_scaytItemList_remove {
	position: absolute;
	top: 0;
	right: 5px;
	width: 26px;
	height: 26px;
}
