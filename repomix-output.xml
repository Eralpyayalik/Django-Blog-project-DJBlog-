<div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden {% if is_reply %}ms-5 bg-light border-start border-primary border-4{% elif comment.comment_author == article_author %}border-start border-danger border-4{% endif %}">
    <div class="card-body p-4">
        <div class="d-flex align-items-start mb-3">
            <div class="flex-shrink-0 me-3 d-flex flex-column align-items-center" style="width: 85px;"> 
                <div class="mb-2">
                    {% if comment.user %}
                        <a href="{% url 'user:profile' username=comment.user.username %}" class="text-decoration-none">
                            {% if comment.user.profile.image %}
                                <img src="{{ comment.user.profile.image.url }}" 
                                    class="rounded-circle border border-2 border-primary border-opacity-10 shadow-sm" 
                                    style="width: 50px; height: 50px; min-width: 50px; min-height: 50px; object-fit: cover;">
                            {% else %}
                                <div class="avatar-circle avatar-{{ comment.comment_author|first|lower }} d-flex align-items-center justify-content-center shadow-sm" 
                                    style="width: 50px; height: 50px; min-width: 50px; min-height: 50px;">
                                    {{ comment.comment_author|first|upper }}
                                </div>
                            {% endif %}
                        </a>
                    {% else %}
                        <div class="avatar-circle bg-secondary d-flex align-items-center justify-content-center shadow-sm text-white" 
                            style="width: 50px; height: 50px; min-width: 50px; min-height: 50px; border-radius: 50%;">
                            {{ comment.comment_author|first|upper }}
                        </div>
                    {% endif %}
                </div>

                {% if comment.user.profile %}
                    <div class="text-center w-100" style="line-height: 1.1;">
                        <span class="d-block fw-bold" style="font-size: 0.62rem; color: {{ comment.user.profile.rank_info.color }}; white-space: nowrap;">
                            <i class="fas {{ comment.user.profile.rank_info.icon }} me-1"></i>
                            {{ comment.user.profile.rank_info.title|upper }}
                        </span>
                        <small class="text-muted d-block mt-1" style="font-size: 0.55rem; font-weight: 600;">
                            {{ comment.user.profile.total_xp }} XP
                        </small>
                    </div>
                {% else %}
                    <span class="badge bg-light text-dark border w-100" style="font-size: 0.55rem;">MİSAFİR</span>
                {% endif %}
            </div>

            <div class="w-100">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="mb-1">
                            {% if comment.user %}
                                <a href="{% url 'user:profile' username=comment.user.username %}" class="text-decoration-none">
                                    <span class="fw-bold text-dark fs-6">{{ comment.comment_author }}</span>
                                </a>
                            {% else %}
                                <span class="fw-bold text-dark fs-6">{{ comment.comment_author }}</span>
                            {% endif %}
                        </div>

                        <div class="comment-badges d-flex gap-1 flex-wrap align-items-center">
                            {% if request.user.is_authenticated and comment.comment_author == request.user.username %}
                                <span class="badge rounded-pill px-2 py-1 shadow-sm text-white" style="background-color: #6c5ce7; font-size: 0.65rem;">
                                    <i class="fas fa-user-circle me-1"></i> SEN
                                </span>
                            {% endif %}

                            {% if comment.comment_author == article_author %}
                                <span class="badge bg-danger rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.65rem;">
                                    <i class="fas fa-pen-nib me-1"></i> YAZAR
                                </span>
                            {% endif %}

                            {% if is_reply %}
                                <span class="badge bg-primary rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.65rem;">YANIT</span>
                            {% endif %}

                            {% if comment.user %}
                                {% if comment.user.is_superuser %}
                                    <span class="badge rounded-pill px-3 py-1 shadow-sm" style="background-color: #212529; font-size: 0.65rem; letter-spacing: 0.5px;">
                                        <i class="fas fa-crown text-warning me-1"></i> YÖNETİCİ
                                    </span>
                                {% elif comment.user.is_staff %}
                                    <span class="badge rounded-pill px-3 py-1 shadow-sm" style="background-color: #198754; font-size: 0.65rem; letter-spacing: 0.5px;">
                                        <i class="fas fa-shield-alt me-1"></i> MODERATÖR
                                    </span>
                                {% else %}
                                    <span class="badge bg-primary rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.65rem;">
