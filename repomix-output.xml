<file path="templates/profile.html">
{% extends "layout.html" %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-lg-4 col-md-5">
            <div class="card shadow-lg border-0 text-center p-4 mb-4">
                <div class="position-relative d-inline-block mx-auto">
                    {% if user_profile.profile and user_profile.profile.image %}
                        <img src="{{ user_profile.profile.image.url }}" class="rounded-circle img-thumbnail shadow" style="width: 160px; height: 160px; object-fit: cover;">
                    {% else %}
                        <div class="rounded-circle img-thumbnail shadow d-flex align-items-center justify-content-center bg-light" style="width: 160px; height: 160px;">
                            <i class="fas fa-user fa-4x text-muted"></i>
                        </div>
                    {% endif %}
                    
                    {% if user_profile.profile %}
                    <span class="position-absolute bottom-0 end-0 badge rounded-pill p-2 shadow" style="background-color: {{ user_profile.profile.rank_info.color }};">
                        <i class="fas {{ user_profile.profile.rank_info.icon }}"></i>
                    </span>
                    {% endif %}
                </div>
                
                <h3 class="mt-3 fw-bold mb-0">
                    {{ user_profile.get_full_name|default:user_profile.username }}
                </h3>
                <p class="text-muted small">@{{ user_profile.username }}</p>

                {% if user_profile.profile %}
                    <div class="badge p-2 mb-3 w-100" 
                        style="background-color: {{ user_profile.profile.rank_info.color }}22; 
                                color: {{ user_profile.profile.rank_info.color }}; 
                                border: 1px solid {{ user_profile.profile.rank_info.color }};">
                        <span class="fw-bold">{{ user_profile.profile.rank_info.title }}</span>
                    </div>

                    <div class="progress mb-2" style="height: 8px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: {{ user_profile.profile.total_xp|default:0 }}%; background-color: {{ user_profile.profile.rank_info.color }};"></div>
                    </div>
                    <small class="text-muted d-block mb-3">{{ user_profile.profile.total_xp|default:0 }} XP Puanı</small>
                {% else %}
                    <div class="badge p-2 mb-3 w-100 bg-light text-muted border">
                        <span class="fw-bold">YENİ ÜYE</span>
                    </div>
                {% endif %}

                <hr>
                <p class="text-secondary small italic px-2">
                    <i class="fas fa-quote-left me-1"></i> {{ user_profile.profile.bio|default:"Sistem analizi bekleniyor... (Biyografi boş)" }}
                </p>
                
                <div class="d-flex justify-content-center gap-3 mt-3">
                    {% if user_profile.profile.github %}
                        <a href="{{ user_profile.profile.github }}" target="_blank" class="btn btn-outline-dark btn-sm rounded-circle"><i class="fab fa-github"></i></a>
                    {% endif %}
                    {% if user_profile.profile.linkedin %}
                        <a href="{{ user_profile.profile.linkedin }}" target="_blank" class="btn btn-outline-primary btn-sm rounded-circle"><i class="fab fa-linkedin-in"></i></a>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary">
                    <i class="fas fa-id-card me-2"></i>Kişisel Bilgiler
                </h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Ad</label>
                        <span class="fw-medium">{{ user_profile.first_name|default:"-" }}</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Soyad</label>
                        <span class="fw-medium">{{ user_profile.last_name|default:"-" }}</span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary">
                    <i class="fas fa-server me-2"></i>Sistem Bilgileri
                </h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">E-Posta Adresi</label>
                        <span class="fw-medium">{{ user_profile.email|default:"Tanımlanmadı" }}</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Katılım Tarihi</label>
                        <span class="fw-medium text-success">{{ user_profile.date_joined|date:"d F Y, H:i" }}</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Son Oturum (Last Login)</label>
                        <span class="fw-medium text-danger">{{ user_profile.last_login|date:"d F Y, H:i" }}</span>
                    </div>
                    <div class="row mt-3">
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Üyelik Tipi</label>
                            
                            {% if user_profile.is_superuser %}
                                <span class="badge bg-dark shadow-sm">
                                    <i class="fas fa-crown text-warning me-1"></i> Yönetici
                                </span>
                            {% elif user_profile.is_staff %}
                                <span class="badge bg-primary shadow-sm">
                                    <i class="fas fa-shield-alt me-1"></i> Moderatör
                                </span>
                            {% else %}
                                <span class="badge bg-info text-white shadow-sm">
                                    <i class="fas fa-user me-1"></i> Standart Üye
                                </span>
                            {% endif %}
                        </div>

                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Hesap Durumu</label>
                            {% if user_profile.is_active %}
                                <span class="badge bg-success">Aktif</span>
                            {% else %}
                                <span class="badge bg-danger">Hesap Askıya Alınmış</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 text-primary"><i class="fas fa-stream me-2"></i>Son Aktiviteler</h5>
                    <div>
                        <span class="badge bg-light text-dark border">Makale: {{ user_profile.article_set.count }}</span>
                        <span class="badge bg-light text-dark border">Yorum: {{ user_profile.comment_set.count }}</span>
                    </div>
                </div>
                
                <div class="list-group list-group-flush">
                    {% for article in user_profile.article_set.all|dictsortreversed:"created_date"|slice:":5" %}
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                        <div>
                            <i class="far fa-file-alt me-2 text-primary"></i>
                            <a href="{% url 'article:detail' article.slug %}" class="text-decoration-none text-dark fw-medium">
                                {{ article.title }}
                            </a>
                        </div>
                        <small class="text-muted">{{ article.created_date|timesince }} önce</small>
                    </div>
                    {% empty %}
                    <p class="text-muted">Henüz veri girişi yapılmadı.</p>
                    {% endfor %}
                </div>

                {% if request.user == user_profile %}
                <div class="mt-4">
                    <a href="{% url 'user:profile_edit' %}" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                        <i class="fas fa-edit me-2"></i>Profili Düzenle
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock body %}
</file>

