<file path="templates/detail.html">
{% extends "layout.html" %}
{% load static %} 
{% load article_extras %} 

{% block body %}
<link rel="stylesheet" href="{% static 'css/test.css' %}">

<div class="row justify-content-center">
    <div class="col-lg-10">
        
        <div class="post-header-premium mb-5 py-5 text-center bg-white border-bottom shadow-sm rounded-4">
            <div class="container">
                {% if article.category %}
                <div class="mb-2">
                    <span class="text-uppercase fw-bold text-muted opacity-75" style="letter-spacing: 2px; font-size: 0.7rem;">
                        <i class="fas fa-tag me-1"></i> {{ article.category }}
                    </span>
                </div>
                {% endif %}

                <h1 class="display-3 fw-bolder text-dark mb-4 ls-tight" style="line-height: 1.1;">
                    {{ article.title }}
                </h1>

                <div class="d-inline-flex flex-wrap align-items-center justify-content-center gap-4 p-2 px-4 bg-light rounded-pill border shadow-sm">
                    <div class="d-flex align-items-center me-2">
                        {% if article.author.profile.image %}
                            <img src="{{ article.author.profile.image.url }}" 
                                class="rounded-circle border border-2 border-white shadow-sm me-2" 
                                style="width: 35px; height: 35px; min-width: 35px; min-height: 35px; object-fit: cover;">
                        {% else %}
                            <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center me-2" 
                                style="width: 35px; height: 35px; min-width: 35px; min-height: 35px; border: 1px solid #eee;">
                                <i class="fas fa-user" style="font-size: 0.8rem;"></i>
                            </div>
                        {% endif %}
                        <span class="fw-bold text-dark small">{{ article.author.username }}</span>
                    </div>

                    <div class="vr d-none d-md-block" style="height: 20px; opacity: 0.1;"></div>

                    <div class="d-flex align-items-center gap-3 small text-muted">
                        <span><i class="far fa-calendar-alt me-1"></i> {{ article.created_date|date:"d M Y" }}</span>
                        <span class="d-inline-flex align-items-center mx-2 text-dark" style="font-size: 0.85rem;">
                            <i class="far fa-clock text-primary me-2 fs-6"></i> 
                            <span class="fw-bold me-1">{{ article.content|read_time }} dk</span> 
                            <span class="text-muted small">okuma süresi</span>
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3 border-start ps-3 ms-1">
                        <div class="stat-item" title="Görüntülenme">
                            <i class="fas fa-eye text-success me-1"></i>
                            <span class="fw-bold">{{ article.read_count }}</span>
                        </div>
                        <div class="stat-item" title="Beğeni">
                            <i class="fas fa-heart text-danger me-1"></i>
                            <span id="like-count" class="fw-bold">{{ article.likes.count }}</span>
                        </div>
                        <div class="stat-item" title="Yorumlar">
                            <i class="fas fa-comments text-info me-1"></i>
                            <strong class="text-dark">{{ article.comments.count }}</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if article.article_image %}
            <img src="{{ article.article_image.url }}" 
                class="img-fluid rounded mb-4 shadow-sm" 
                style="width: 100%; height: auto; display: block;" 
                alt="{{ article.title }}">
        {% endif %}

        <div class="article-body shadow-none p-2 mb-5">
            <div class="content-text lh-lg text-secondary" style="font-size: 1.15rem; letter-spacing: 0.3px;">
                {{ article.content|safe }}
            </div>
        </div>

        <div class="d-flex mt-5 mb-5 border-top pt-4">
            <div class="like-section">
                {% if request.user.is_authenticated %}
                    <button id="like-btn" 
                            data-article-id="{{ article.id}}" 
                            type="button"
                            class="btn {% if request.user in article.likes.all %}btn-danger{% else %}btn-outline-danger{% endif %} rounded-pill shadow-sm px-4 py-2 border-2">
                        <i id="like-icon" class="{% if request.user in article.likes.all %}fas{% else %}far{% endif %} fa-heart me-1"></i>
                        <span id="like-text" style="font-size: 0.9rem;" class="fw-bold">
                            {% if request.user in article.likes.all %}Beğenildi{% else %}Beğen{% endif %}
                        </span>
                    </button>
                {% else %}
                    <a href="{% url 'user:login' %}" class="btn btn-outline-secondary rounded-pill shadow-sm px-4 py-2 border-2">
                        <i class="far fa-heart me-1"></i> 
                        <span style="font-size: 0.9rem;" class="fw-bold">Beğenmek için giriş yap</span>
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="mt-5 pt-4 border-top d-flex justify-content-between align-items-center">
            <a href="{% url 'article:dashboard' %}" class="btn btn-dark btn-sm rounded-pill px-4">
                ← Dashboard'a Dön
            </a>
        </div>

        <div class="container mt-5 px-0">
            <section class="mb-5">
                <h4 class="fw-bold mb-4"><i class="fas fa-pen-nib me-2"></i>Bir Yorum Bırak</h4>
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body p-4">
                        <form id="comment-form" method="post" action="{% url 'article:comment' article.id %}">
                            {% csrf_token %}
                            <input type="hidden" name="parent_id" id="parent_id" value="">
                            
                            <div id="replying-to" class="mb-3 d-none">
                                <div class="alert alert-info d-flex justify-content-between align-items-center mb-0 py-2">
                                    <span><i class="fas fa-reply me-2"></i><strong id="reply-target"></strong> kullanıcısına yanıt veriyorsun</span>
                                    <button type="button" class="btn-close" id="cancel-reply" style="font-size: 0.7rem;"></button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="comment_author" class="form-label fw-bold">Yorum Yapan</label>
                                {% if request.user.is_authenticated %}
                                    <input name="comment_author" type="text" class="form-control border-0 shadow-sm bg-light" 
                                        id="comment_author" value="{{ request.user.username }}" readonly>
                                    <small class="text-success"><i class="fas fa-check-circle"></i> {{ request.user.username }} olarak oturum açtın.</small>
                                {% else %}
                                    <input name="comment_author" type="text" class="form-control border-0 shadow-sm" 
                                        id="comment_author" placeholder="Adınız soyadınız..." required>
                                {% endif %}
                            </div>

                            <div class="mb-3">
                                <label for="comment_content" class="form-label fw-bold">Yorumunuz</label>
                                <textarea name="comment_content" class="form-control border-0 shadow-sm" id="comment_content" rows="3" placeholder="Düşüncelerini paylaş..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-danger px-4 rounded-pill fw-bold">
                                <i class="fas fa-paper-plane me-2"></i>Gönder
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            <hr class="my-5">

            <section class="mb-5">
                <h4 class="fw-bold mb-4">
                    <i class="fas fa-comments me-2"></i>Yorumlar 
                    <span class="badge bg-secondary rounded-pill ms-2" style="font-size: 0.9rem;">{{ article.comments.count }}</span>
                </h4>

                {% if comments %}
                <div id="comment-list">
                    {% for comment in comments %}
                        {% include "includes/comment_item.html" with comment=comment article_author=article.author.username %}
                    {% endfor %}
                </div>
                {% else %}
                    <div class="alert alert-light border-0 shadow-sm text-center py-5 rounded-4">
                        <i class="far fa-comment-dots fa-3x mb-3 d-block opacity-25 text-primary"></i>
                        <span class="text-muted">Henüz yorum yapılmamış. İlk yorumu sen ateşle!</span>
                    </div>
                {% endif %}
            </section>
        </div>
    </div>
</div>

<style>
    .content-text p { margin-bottom: 2rem; }
    #like-btn { transition: transform 0.2s ease, background-color 0.3s ease; }
    #like-btn:active { transform: scale(0.9); }
    .comment-badges .badge { height: fit-content; }
</style>
{% endblock body %}

{% block scripts %}
    <script>
        if (typeof csrftoken === 'undefined') {
            var csrftoken = "{{ csrf_token }}";
        }

        document.addEventListener('DOMContentLoaded', function() {
            const replyBtns = document.querySelectorAll('.reply-btn');
            const parentIdInput = document.getElementById('parent_id');
            const replyingToDiv = document.getElementById('replying-to');
            const replyTargetSpan = document.getElementById('reply-target');
            const cancelReplyBtn = document.getElementById('cancel-reply');
            const commentContent = document.getElementById('comment_content');

            replyBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const commentId = this.getAttribute('data-comment-id');
                    const author = this.getAttribute('data-author');
                    
                    parentIdInput.value = commentId;
                    replyTargetSpan.innerText = author;
                    replyingToDiv.classList.remove('d-none');
                    
                    commentContent.focus();
                    commentContent.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            });

            cancelReplyBtn.addEventListener('click', function() {
                parentIdInput.value = '';
                replyingToDiv.classList.add('d-none');
            });
        });
    </script>
    <script src="{% static 'js/filter.js' %}"></script>
{% endblock scripts %}
</file>

